# ─────────────────────────────────────────────────────────────────────
# MP Education Policy Modeling System — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────

# ── GROQ API (Required for LLM features) ─────────────────────────────
# Get your free API key at: https://console.groq.com/
# Model used: llama-3.3-70b-versatile (LLaMA 70B)
GROQ_API_KEY=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

# ── Backend Config ────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO

# ── Frontend Config (Vite) ────────────────────────────────────────────
# URL of the FastAPI backend (used by React app)
VITE_API_URL=http://localhost:8000

# ── Optional: Force dataset rebuild on startup ────────────────────────
# Set to "true" to re-download/rebuild the dataset on every startup
FORCE_REBUILD_DATA=false

# ── Optional: data.gov.in API key ────────────────────────────────────
# Get at: https://data.gov.in/user/register
DATA_GOV_IN_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# National Healthcare Policy Decision Intelligence System (NHP-DIS)
# Production & Local Environment Configuration
# Copy this file to `.env` in the root or in respective subdirectories.
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. Groq Cloud API Key (Optional) ─────────────────────────────────────────
# Powers LLaMA-3.3-70B natural language policy synthesis & Policy Copilot.
# Get a free API key at: https://console.groq.com/keys
# If left blank, the system automatically uses deterministic neuro-symbolic
# rule-based causal path explanations without crashing.
GROQ_API_KEY=your_groq_api_key_here

# ── 2. Backend Server Configuration (FastAPI / Uvicorn) ─────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO

# ── 3. Frontend Build Configuration (Vite / React) ──────────────────────────
# The URL where the frontend makes REST requests to the FastAPI backend.
#
# LOCAL DEV:
#   VITE_API_URL=http://localhost:8000
#
# CLOUDFLARE PRODUCTION (Same-Domain / Reverse Proxy / Cloudflare Tunnel):
#   Leave blank or set to "" (frontend will automatically make same-origin requests)
#   VITE_API_URL=
#
# CLOUDFLARE PRODUCTION (Dedicated API Subdomain, e.g. api.yourdomain.com):
#   VITE_API_URL=https://api.yourdomain.com
VITE_API_URL=http://localhost:8000

# ── 4. Cloudflare / Domain Configuration ─────────────────────────────────────
# Replace with your actual apex or sub-domain
DOMAIN=yourdomain.com
API_SUBDOMAIN=api.yourdomain.com
APP_SUBDOMAIN=policy.yourdomain.com

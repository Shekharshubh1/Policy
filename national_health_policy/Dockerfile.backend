FROM python:3.11-slim

WORKDIR /app

# Install system dependencies needed for compiling scientific packages if needed
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy backend requirements and install
COPY national_health_policy/backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend, data, and models
COPY national_health_policy/backend/ ./backend/
COPY national_health_policy/data/ ./data/
COPY national_health_policy/models/ ./models/

WORKDIR /app/backend

EXPOSE 8000

ENV BACKEND_HOST=0.0.0.0
ENV BACKEND_PORT=8000
ENV PYTHONUNBUFFERED=1

CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]

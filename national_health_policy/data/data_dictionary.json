{
  "variables": {
    "per_capita_health_expenditure": {
      "type": "input",
      "domain": "Healthcare Spending",
      "unit": "₹/year",
      "min": 500,
      "max": 25000,
      "step": 250,
      "default": 3800,
      "inverted": false,
      "description": "Total government and private healthcare expenditure per capita",
      "source": "National Health Accounts (NHA) & State Budgets"
    },
    "public_health_budget_share": {
      "type": "input",
      "domain": "Healthcare Spending",
      "unit": "% of GSDP",
      "min": 0.5,
      "max": 12.0,
      "step": 0.1,
      "default": 2.2,
      "inverted": false,
      "description": "Share of State/District budget dedicated to public healthcare",
      "source": "RBI State Finances & MoF Reports"
    },
    "insurance_coverage": {
      "type": "input",
      "domain": "Healthcare Spending",
      "unit": "% population",
      "min": 0.0,
      "max": 100.0,
      "step": 1.0,
      "default": 42.0,
      "inverted": false,
      "description": "% population covered under PM-JAY or state health assurance schemes",
      "source": "PM-JAY Dashboard & NFHS-5"
    },
    "hospital_density": {
      "type": "input",
      "domain": "Infrastructure",
      "unit": "per 100k pop",
      "min": 0.1,
      "max": 15.0,
      "step": 0.1,
      "default": 2.4,
      "inverted": false,
      "description": "Sub-divisional and District hospitals per 100,000 population",
      "source": "Rural Health Statistics (RHS) MoHFW"
    },
    "phc_density": {
      "type": "input",
      "domain": "Infrastructure",
      "unit": "per 100k pop",
      "min": 0.5,
      "max": 25.0,
      "step": 0.5,
      "default": 5.8,
      "inverted": false,
      "description": "Primary Health Centres and Health & Wellness Centres per 100k pop",
      "source": "Rural Health Statistics (RHS) MoHFW"
    },
    "bed_availability": {
      "type": "input",
      "domain": "Infrastructure",
      "unit": "beds / 10k pop",
      "min": 2.0,
      "max": 150.0,
      "step": 1.0,
      "default": 14.0,
      "inverted": false,
      "description": "Total public and empaneled private hospital beds per 10,000 population",
      "source": "HMIS & National Health Profile"
    },
    "doctor_ratio": {
      "type": "input",
      "domain": "Human Resources",
      "unit": "per 10k pop",
      "min": 0.2,
      "max": 25.0,
      "step": 0.1,
      "default": 7.2,
      "inverted": false,
      "description": "Allopathic doctors in position per 10,000 population (WHO norm: 10)",
      "source": "National Medical Commission & RHS"
    },
    "nurse_ratio": {
      "type": "input",
      "domain": "Human Resources",
      "unit": "per 10k pop",
      "min": 1.0,
      "max": 60.0,
      "step": 0.5,
      "default": 16.5,
      "inverted": false,
      "description": "Staff Nurses and auxiliary nurse midwives (ANMs) per 10,000 population",
      "source": "Indian Nursing Council & RHS"
    },
    "specialist_availability": {
      "type": "input",
      "domain": "Human Resources",
      "unit": "% required",
      "min": 0.0,
      "max": 100.0,
      "step": 1.0,
      "default": 28.0,
      "inverted": false,
      "description": "% sanctioned specialist posts filled at Community Health Centres",
      "source": "Rural Health Statistics (RHS)"
    },
    "asha_worker_density": {
      "type": "input",
      "domain": "Human Resources",
      "unit": "per 10k pop",
      "min": 2.0,
      "max": 40.0,
      "step": 0.5,
      "default": 12.0,
      "inverted": false,
      "description": "Accredited Social Health Activists (ASHAs) deployed per 10,000 rural pop",
      "source": "NHM Management Information System"
    },
    "immunization_rate": {
      "type": "input",
      "domain": "Preventive Care",
      "unit": "% children",
      "min": 20.0,
      "max": 100.0,
      "step": 0.5,
      "default": 76.5,
      "inverted": false,
      "description": "% children age 12-23 months fully immunized with core vaccines",
      "source": "NFHS-5 & HMIS"
    },
    "screening_coverage": {
      "type": "input",
      "domain": "Preventive Care",
      "unit": "% adults 30+",
      "min": 0.0,
      "max": 100.0,
      "step": 1.0,
      "default": 35.0,
      "inverted": false,
      "description": "% population age 30+ screened for hypertension, diabetes, and cancers",
      "source": "CPHC-NCD Portal MoHFW"
    },
    "institutional_delivery_rate": {
      "type": "input",
      "domain": "Preventive Care",
      "unit": "% live births",
      "min": 25.0,
      "max": 100.0,
      "step": 0.5,
      "default": 88.6,
      "inverted": false,
      "description": "% of total deliveries conducted in accredited healthcare facilities",
      "source": "HMIS & NFHS-5"
    },
    "literacy_rate": {
      "type": "input",
      "domain": "Social Determinants",
      "unit": "% population",
      "min": 30.0,
      "max": 100.0,
      "step": 0.5,
      "default": 74.0,
      "inverted": false,
      "description": "Overall adult literacy rate (age 7+)",
      "source": "Census 2011 & NSO Surveys"
    },
    "female_literacy": {
      "type": "input",
      "domain": "Social Determinants",
      "unit": "% females",
      "min": 20.0,
      "max": 100.0,
      "step": 0.5,
      "default": 65.4,
      "inverted": false,
      "description": "Female literacy rate (age 7+)",
      "source": "Census 2011 & NFHS-5"
    },
    "sanitation_access": {
      "type": "input",
      "domain": "Social Determinants",
      "unit": "% households",
      "min": 15.0,
      "max": 100.0,
      "step": 0.5,
      "default": 71.0,
      "inverted": false,
      "description": "% households with access to improved individual household latrines",
      "source": "Swachh Bharat Mission (SBM-G) & NFHS-5"
    },
    "clean_water_access": {
      "type": "input",
      "domain": "Social Determinants",
      "unit": "% households",
      "min": 10.0,
      "max": 100.0,
      "step": 0.5,
      "default": 68.5,
      "inverted": false,
      "description": "% households with functional tap water connection",
      "source": "Jal Jeevan Mission (JJM) Portal"
    },
    "telemedicine_access": {
      "type": "input",
      "domain": "Digital Health",
      "unit": "% HWCs",
      "min": 0.0,
      "max": 100.0,
      "step": 1.0,
      "default": 48.0,
      "inverted": false,
      "description": "% Health & Wellness Centres actively conducting eSanjeevani teleconsults",
      "source": "eSanjeevani Teleconsultation Dashboard"
    },
    "digital_health_records": {
      "type": "input",
      "domain": "Digital Health",
      "unit": "% pop ABHA",
      "min": 0.0,
      "max": 100.0,
      "step": 1.0,
      "default": 36.0,
      "inverted": false,
      "description": "% district population with Ayushman Bharat Health Account (ABHA) IDs",
      "source": "Ayushman Bharat Digital Mission (ABDM)"
    },
    "communicable_disease_rate": {
      "type": "input",
      "domain": "Disease Burden",
      "unit": "cases/100k",
      "min": 10,
      "max": 5000,
      "step": 10,
      "default": 480,
      "inverted": true,
      "description": "Reported incidence of vector-borne and diarrheal diseases per 100,000",
      "source": "Integrated Disease Surveillance Programme (IDSP)"
    },
    "non_communicable_disease_rate": {
      "type": "input",
      "domain": "Disease Burden",
      "unit": "cases/100k",
      "min": 500,
      "max": 25000,
      "step": 50,
      "default": 6200,
      "inverted": true,
      "description": "Prevalence of hypertension, diabetes, and cardiovascular diseases",
      "source": "ICMR India: Health of Nation's States"
    },
    "poverty_rate": {
      "type": "input",
      "domain": "Economic Indicators",
      "unit": "% MPI",
      "min": 1.0,
      "max": 75.0,
      "step": 0.5,
      "default": 18.5,
      "inverted": true,
      "description": "Multidimensional Poverty Index headcount ratio (%)",
      "source": "NITI Aayog National MPI"
    },
    "income_level": {
      "type": "input",
      "domain": "Economic Indicators",
      "unit": "₹ DDP/capita",
      "min": 18000,
      "max": 450000,
      "step": 1000,
      "default": 115000,
      "inverted": false,
      "description": "District Gross Domestic Product per capita (INR)",
      "source": "Directorate of Economics & Statistics"
    },
    "healthcare_accessibility": {
      "type": "intermediate",
      "domain": "Latent Structural",
      "unit": "Index (0-100)",
      "min": 0,
      "max": 100,
      "inverted": false,
      "description": "Physical, digital, and geographical ease of accessing care facilities"
    },
    "service_quality": {
      "type": "intermediate",
      "domain": "Latent Structural",
      "unit": "Index (0-100)",
      "min": 0,
      "max": 100,
      "inverted": false,
      "description": "Clinical quality, medical workforce presence, and bed adequacy"
    },
    "preventive_health_adoption": {
      "type": "intermediate",
      "domain": "Latent Behavioral",
      "unit": "Index (0-100)",
      "min": 0,
      "max": 100,
      "inverted": false,
      "description": "Community health-seeking behavior and preventive screening uptake"
    },
    "maternal_health_status": {
      "type": "intermediate",
      "domain": "Latent Clinical",
      "unit": "Index (0-100)",
      "min": 0,
      "max": 100,
      "inverted": false,
      "description": "Overall maternal health resilience and safe delivery assurance"
    },
    "child_health_status": {
      "type": "intermediate",
      "domain": "Latent Clinical",
      "unit": "Index (0-100)",
      "min": 0,
      "max": 100,
      "inverted": false,
      "description": "Early childhood nutritional resilience and vaccine coverage adequacy"
    },
    "disease_prevention_effectiveness": {
      "type": "intermediate",
      "domain": "Latent Clinical",
      "unit": "Index (0-100)",
      "min": 0,
      "max": 100,
      "inverted": false,
      "description": "Public health capacity to arrest outbreak transmission and chronic conditions"
    },
    "population_health_risk": {
      "type": "intermediate",
      "domain": "Latent Risk",
      "unit": "Risk Index (0-100)",
      "min": 0,
      "max": 100,
      "inverted": true,
      "description": "Environmental, sanitation, and baseline disease vulnerability"
    },
    "maternal_mortality_rate": {
      "type": "output",
      "domain": "Health Outcomes",
      "unit": "per 100k live births",
      "min": 15,
      "max": 450,
      "inverted": true,
      "good_threshold": 70,
      "description": "Maternal Mortality Ratio (MMR per 100,000 live births; SDG target: 70)",
      "source": "Sample Registration System (SRS) & HMIS"
    },
    "infant_mortality_rate": {
      "type": "output",
      "domain": "Health Outcomes",
      "unit": "per 1,000 live births",
      "min": 4.0,
      "max": 95.0,
      "inverted": true,
      "good_threshold": 23,
      "description": "Infant Mortality Rate (IMR per 1,000 live births; SDG target: 23)",
      "source": "Sample Registration System (SRS) & NFHS-5"
    },
    "life_expectancy": {
      "type": "output",
      "domain": "Health Outcomes",
      "unit": "years",
      "min": 55.0,
      "max": 82.0,
      "inverted": false,
      "good_threshold": 72,
      "description": "Estimated life expectancy at birth in years",
      "source": "SRS Life Tables & WHO Benchmarks"
    },
    "health_equity_index": {
      "type": "output",
      "domain": "System Performance",
      "unit": "Score (0-100)",
      "min": 0,
      "max": 100,
      "inverted": false,
      "good_threshold": 75,
      "description": "Equity score reflecting parity between rural/urban and tribal sub-groups",
      "source": "Derived Concentration Index"
    },
    "disease_burden_index": {
      "type": "output",
      "domain": "Health Outcomes",
      "unit": "DALYs / 1000",
      "min": 80,
      "max": 480,
      "inverted": true,
      "good_threshold": 180,
      "description": "Age-standardized Disability Adjusted Life Years lost per 1,000 population",
      "source": "Global Burden of Disease (ICMR)"
    },
    "universal_health_coverage_score": {
      "type": "output",
      "domain": "System Performance",
      "unit": "SDG 3.8.1 (0-100)",
      "min": 10,
      "max": 100,
      "inverted": false,
      "good_threshold": 80,
      "description": "Composite coverage index of essential health services (WHO SDG 3.8.1)",
      "source": "WHO & MoHFW SDG Framework"
    },
    "overall_health_index": {
      "type": "output",
      "domain": "System Performance",
      "unit": "Index (0-100)",
      "min": 10,
      "max": 100,
      "inverted": false,
      "good_threshold": 70,
      "description": "NITI Aayog-style composite health performance score across domains",
      "source": "NITI Aayog Healthy States Progressive India"
    }
  }
}
